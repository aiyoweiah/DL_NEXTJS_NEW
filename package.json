{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "prebuild": "node scripts/check-surfaces.mjs && node scripts/check-cjk-coverage.mjs && node scripts/check-gilt-escrow.mjs && node scripts/check-tokens.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postbuild": "node scripts/check-cjk-coverage.mjs --build && node scripts/check-font-preload.mjs && node scripts/check-surfaces.mjs --build && node scripts/check-gilt-escrow.mjs --build && node scripts/check-tokens.mjs --build",
    "fonts:cjk": "node scripts/build-cjk-subset.mjs",
    "fonts:report": "node scripts/build-cjk-subset.mjs --report",
    "check:tokens": "node scripts/check-tokens.mjs",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "next": "^16.2.6",
    "postcss": "8.4.30",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2"
  },
  "devDependencies": {
    "subset-font": "^2.7.0"
  }
}
